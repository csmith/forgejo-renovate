{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitsDisabled"],
  "prHourlyLimit": 0,
  "minimumReleaseAge": "28 days",
  "internalChecksFilter": "strict",
  "assignees": ["chris"],
  "branchTopic": "{{{depNameSanitized}}}-{{{newVersion}}}",
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "customDatasources": {
    "rendock": {
      "defaultRegistryUrlTemplate": "http://rendock:8080/v1/tags/{{packageName}}"
    }
  },
  "dockerfile": {
    "enabled": false
  },
  "docker-compose": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Resolve Dockerfile base images via rendock so they get accurate first-seen timestamps",
      "managerFilePatterns": [
        "/(^|/)Dockerfile[^/]*$/",
        "/(^|/)Containerfile[^/]*$/"
      ],
      "matchStrings": [
        "(?m)^[ \\t]*FROM[ \\t]+(?:--platform=\\S+[ \\t]+)?(?<depName>[^\\s:@]+):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "custom.rendock",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Resolve docker-compose images via rendock so they get accurate first-seen timestamps",
      "managerFilePatterns": [
        "/(^|/)docker-compose[^/]*\\.ya?ml$/",
        "/(^|/)compose[^/]*\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?m)^[ \\t]*image:[ \\t]*[\"']?(?<depName>[^\\s:@\"']+):(?<currentValue>[^\\s@\"']+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?"
      ],
      "datasourceTemplate": "custom.rendock",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["meta/workflows"],
      "registryUrls": ["https://git.yak-wall.ts.net"]
    },
    {
      "matchManagers": ["gomod"],
      "matchPackageNames": ["go"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "0 days"
    },
    {
      "matchManagers": ["gomod"],
      "matchPackagePatterns": ["^tailscale\\.com", "^golang\\.org/x/"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["gomod"],
      "matchPackageNames": ["modernc.org/sqlite"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["gomod"],
      "matchPackagePatterns": [
        "^github\\.com\\/csmith\\/",
        "^chameth\\.com\\/"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "0 days"
    },
    {
      "matchManagers": ["gomod"],
      "matchPackagePatterns": [
        "^github\\.com\\/csmith\\/",
        "^chameth\\.com\\/"
      ],
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchDatasources": ["custom.rendock"],
      "matchPackageNames": ["ghcr.io/greboid/dockerbase/nonroot"],
      "automerge": true
    },
    {
      "matchDatasources": ["custom.rendock"],
      "matchPackageNames": ["golang"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "0 days"
    }
  ]
}
